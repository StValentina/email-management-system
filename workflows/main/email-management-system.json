        "categories": {
          "categories": [
            {
              "category": "Client Support & Service Requests",
              "description": "Emails from existing or past clients asking for help, clarification, troubleshooting, changes, support, status updates, or information related to a service or project they already use or have previously purchased from LinguaTech Solutions.\n\nIncludes questions about existing RAG/chatbot systems, NLP solutions, delivered datasets, annotations, consultations, maintenance, access, technical issues, service policies, or previously agreed work.\n\nDo NOT use this category for a new project, a new service quotation, pricing for work not yet purchased, invoices, payment documents, or internal team communication."
            },
            {
              "category": "Billing & Payments",
              "description": "Emails primarily related to financial transactions, invoices, receipts, payment confirmations, amounts due, billing documents, VAT information, vendor invoices, or other accounting and payment matters involving LinguaTech Solutions.\n\nUse this category when the main purpose of the email is financial processing.\n\nDo NOT classify general questions about the price of a potential new service here; those belong to Projects & Service Inquiries."
            },
            {
              "category": "Projects & Service Inquiries",
              "description": "Emails from potential clients or existing clients asking about a new project, new service, quotation, pricing, capabilities, scope, timeline, proposal, consultation, demo, or potential cooperation with LinguaTech Solutions.\n\nIncludes requests for RAG/chatbot development, NLP or LLM evaluation, text processing, corpus or annotation projects, training, and other services not already covered by an existing active service request.\n\nDo NOT use this category for troubleshooting or support concerning an already purchased service."
            },
            {
              "category": "Team & Operations",
              "description": "Emails from employees using our company domain (@example.com).\n\nEmails that are part of LinguaTech Solutions' internal business communication, including messages from employees, managers, contractors, or recognized internal collaborators about meetings, schedules, assignments, project coordination, internal reports, deadlines, operational updates, or administrative matters.\n\nInternal sender identity and business context are strong indicators.\n\nDo NOT use this category for customer, supplier, sales, or payment communication merely because it discusses a company project."
            }
          ]
        },
