      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"emailBody\": {\n      \"type\": \"string\",\n      \"description\": \"The HTML-formatted body of the draft reply to the potential client. Use <p>, <br>, and <a> tags when appropriate. Populate this field ONLY when escalate=false. If escalate=true, return an empty string.\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One concise sentence explaining why the response can be safely drafted or why the request requires human review.\"\n    },\n    \"escalate\": {\n      \"type\": \"boolean\",\n      \"description\": \"Set to true when the request requires custom scoping, a binding quotation, price negotiation, undocumented capabilities, uncertain technical feasibility, legal or security review, or when the LinguaTech Solutions services knowledge base does not provide sufficient information. When in doubt, choose true.\"\n    },\n    \"knowledgeDatabase\": {\n      \"type\": \"string\",\n      \"description\": \"Briefly state the facts from the LinguaTech Solutions services knowledge base that were actually used. If no knowledge-base information was used, write 'not used'.\"\n    }\n  },\n  \"required\": [\n    \"emailBody\",\n    \"reason\",\n    \"escalate\",\n    \"knowledgeDatabase\"\n  ],\n  \"additionalProperties\": false\n}"
      },
