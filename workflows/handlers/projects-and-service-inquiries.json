      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Call this tool to retrieve the OFFICIAL services catalogue and commercial information of LinguaTech Solutions.\n\nAlways use this tool before answering project or service inquiries.\n\nUse it to retrieve information about:\n- available NLP, LLM, RAG, chatbot and AI automation services,\n- text data processing,\n- corpus creation and linguistic annotation,\n- NLP and LLM evaluation,\n- consulting and corporate training,\n- starting prices,\n- typical project duration,\n- typical deliverables,\n- service limitations and suitable use cases.\n\nPrices in this knowledge base are STARTING PRICES only. They are not binding quotations.\n\nDo NOT invent services, prices, discounts, delivery dates, integrations, or capabilities that are not documented.\n\nIf the requested project is not clearly covered, requires custom scoping, or the retrieved information is insufficient, return the available information and indicate that human review is required.",
        "pineconeIndex": {
          "__rl": true,
          "value": "customer-support",
          "mode": "list",
          "cachedResultName": "customer-support"
        },
        "options": {
          "pineconeNamespace": "services"
        }
      },
