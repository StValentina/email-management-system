    {
      "parameters": {
        "jsCode": "const outputText = $json.messageText || ''; \nconst estimatedTokens = Math.ceil(outputText.length / 4); \n\nconst pricePerMillion = 0.60;\nconst cost = (estimatedTokens / 1_000_000) * pricePerMillion;\n\nreturn [{ json: { ...$json, price: cost.toFixed(6) } }];"
